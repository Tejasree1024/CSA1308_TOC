#include <stdio.h>
#include <string.h>

int main() {
    char str[100];
    int i, found = 0;

    printf("Enter a binary string: ");
    scanf("%99s", str);

    for (i = 0; str[i] != '\0'; i++) {
        if (str[i] == '1' &&
            str[i + 1] == '0' &&
            str[i + 2] == '1') {
            found = 1;
            break;
        }
    }

    if (found)
        printf("String belongs to the CFG\n");
    else
        printf("String does not belong to the CFG\n");

    return 0;
}
